{
  "name": "un1ca-build-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "format": "prettier --write \"src/**/*.{js,vue,css,json}\" \"public/*.{js,html,webmanifest}\" \"*.{js,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,json}\" \"public/*.{js,html,webmanifest}\" \"*.{js,cjs,json}\""
  },
  "dependencies": {
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
