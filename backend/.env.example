REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:////data/app.db
# DATABASE_URL=mysql+pymysql://un1ca:un1ca@mariadb:3306/un1ca
# Legacy single-repo root; adopted as the first workspace on upgrade.
UN1CA_ROOT=/workspace/UN1CA
OUT_DIR=/workspace/UN1CA/out
# Parent dir holding one sub-directory per workspace, plus _shared/ for the
# firmware cache shared by workspaces that opt into it.
WORKSPACES_ROOT=/workspace
LOGS_DIR=/data/logs
CORS_ORIGINS=*
